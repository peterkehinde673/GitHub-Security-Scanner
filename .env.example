# Node Environment ('production' or 'development')
NODE_ENV=production

# Server Port (Render automatically sets this in production)
PORT=3000

# Server-side Gemini API Key (Optional: enables AI Security Copilot explanations)
# The scanner is 100% functional without this key; heuristic AppSec explanations will be used if omitted.
GEMINI_API_KEY=

# Optional GitHub Personal Access Token (Increases rate limit from 60/hr to 5,000/hr and enables private repo scanning)
GITHUB_TOKEN=

# CORS Configuration: Comma-separated list of allowed origins (e.g. https://my-app.onrender.com,https://example.com)
# When deployed on Render, RENDER_EXTERNAL_URL is automatically trusted. CORS_ORIGIN is only required for external/custom domains.
CORS_ORIGIN=

# In-Memory Rate Limiting Configuration (Defaults: windowMs = 60000, maxRequests = 60)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

