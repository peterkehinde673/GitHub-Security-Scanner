# Server-side Gemini API Key
GEMINI_API_KEY=

# Optional GitHub Personal Access Token for higher API rate limits
GITHUB_TOKEN=

# CORS Configuration: Comma-separated list of allowed origins (e.g. https://my-app.onrender.com,https://example.com)
# Defaults to permissive in development and strict same-origin in production
CORS_ORIGIN=

# In-Memory Rate Limiting Configuration (Defaults: windowMs = 60000, maxRequests = 60)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
